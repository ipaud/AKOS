# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*~

# Logs / temp
*.log
/tmp/
.cache/

# Local project-integration output (AKOS writes these INTO other projects,
# not here — listed defensively in case someone runs install-project at the root)
/.akos/
/CLAUDE.md.local

# Node (in case tooling is added later)
node_modules/

# Python (schemas/, rules/, benchmarks/ tooling)
__pycache__/
*.pyc

# Generated benchmark output — reproduce with `akos benchmark`, don't commit
/benchmarks/report.md
/benchmarks/report.json

# update.sh's concurrency lock — if a crashed run's trap never fired, this
# would otherwise show up as untracked noise (or worse, get committed).
/.akos-update.lock
.gstack/
