#!/usr/bin/env bash
#
# akos — AI Knowledge Operating System CLI
# Tool-agnostic. Generates project integration files; does not call an LLM.
#
set -euo pipefail

# --- Resolve AKOS_HOME (the repo root), following symlinks ---
resolve_akos_home() {
  local src="${BASH_SOURCE[0]}"
  while [ -h "$src" ]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  # bin/akos → repo root is one level up
  cd -P "$(dirname "$src")/.." >/dev/null 2>&1 && pwd
}
AKOS_HOME="${AKOS_HOME:-$(resolve_akos_home)}"

MARK_START="<!-- AKOS:START -->"
MARK_END="<!-- AKOS:END -->"

c_bold=$'\033[1m'; c_green=$'\033[32m'; c_yellow=$'\033[33m'; c_red=$'\033[31m'; c_reset=$'\033[0m'
info()  { printf '%s\n' "$*"; }
ok()    { printf '%s✓%s %s\n' "$c_green" "$c_reset" "$*"; }
warn()  { printf '%s!%s %s\n' "$c_yellow" "$c_reset" "$*"; }
err()   { printf '%s✗%s %s\n' "$c_red" "$c_reset" "$*" >&2; }

# --- Name validation for commands that build filesystem paths from user input ---
# Exactly the charset knowledge-pack.schema.json enforces for a pack `name`
# (^[a-z0-9]+(-[a-z0-9]+)*$), so a scaffolded pack always validates. This is
# the CLI-side twin of schemas/config_check.py's packs_root prefix check:
# without it, `akos create-pack "../../evil"` scaffolded outside packs/
# (verified), and a quote in a profile name broke out of an inline
# python3 -c script. Reserved `_`-prefixed dirs (e.g. _template) are fixtures,
# not user-creatable — the schema rejects that name too.
valid_segment() { [[ "$1" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; }

# --- Marker-safe file section writer ---
# Writes a section between AKOS:START/END markers. Creates file if absent,
# appends the section if markers absent, replaces between markers if present.
# Never touches content outside the markers.
write_marked_section() {
  local file="$1"; local body="$2"
  local block
  block="$(printf '%s\n%s\n%s\n' "$MARK_START" "$body" "$MARK_END")"

  if [ ! -f "$file" ]; then
    mkdir -p "$(dirname "$file")"
    printf '%s\n' "$block" > "$file"
    ok "created $file"
    return
  fi
  if grep -qF "$MARK_START" "$file" 2>/dev/null; then
    # Replace between markers via sed line ranges — NOT awk -v with a
    # multi-line value. Confirmed: BSD awk (macOS's stock /usr/bin/awk)
    # cannot accept an embedded newline in a `-v var=value` assignment; it
    # exits nonzero with "newline in string" and prints nothing. Under
    # `set -e` that aborts before `mv` runs, so it never corrupts the file —
    # but it also never updates it, silently, which is worse: every rerun of
    # `install-project` against an already-marked file was a silent no-op.
    local start_line end_line total_lines
    start_line="$(grep -nF "$MARK_START" "$file" | head -n1 | cut -d: -f1)"
    end_line="$(grep -nF "$MARK_END" "$file" | head -n1 | cut -d: -f1)"
    total_lines="$(wc -l < "$file" | tr -d ' ')"
    local tmp; tmp="$(mktemp)"
    {
      [ "$start_line" -gt 1 ] && sed -n "1,$((start_line - 1))p" "$file"
      printf '%s\n' "$block"
      [ "$end_line" -lt "$total_lines" ] && sed -n "$((end_line + 1)),\$p" "$file"
      true
    } > "$tmp"
    mv "$tmp" "$file"
    ok "updated AKOS section in $file"
  else
    printf '\n%s\n' "$block" >> "$file"
    ok "appended AKOS section to $file"
  fi
}

cmd_help() {
  cat <<EOF
${c_bold}akos${c_reset} — AI Knowledge Operating System CLI

Usage: akos <command> [args]

Commands:
  help                 Show this help
  doctor               Run the AKOS health check
  install-project      Add AKOS integration files to the current project
  link-project         Alias for install-project (current directory)
  list-packs           List all knowledge packs
  list-agents          List all review agents
  list-skills          List the agent skills (Claude Code + Codex CLI)
  show-profile [name]  Show a reasoning profile (or list them)
  review <domain>      Print the prompt to run a review (ux|security|architecture|full)
  create-pack <path>   Scaffold a new pack (e.g. ux/my-source) with the 17-file structure
  validate [target]    Validate packs/agents/workflows against their schemas (--format json)
  check-config [dir]   Check a project's .akos/config.md against the allowed value set
  profile <sub>        list|show <name>|create <name>|use <name> [dir] — personal profiles
  rules <sub>          list|run <dir> [--rule ID] [--domain D] [--profile P]|explain <ID>
  freshness [opts]     Pack review-freshness report (--expired|--due-soon|--pack ID|--fail-on BAND)
  benchmark [run|list] Run the rule-detection benchmark suite (--case ID|--domain D|--format json)
  eval --report PATH   Grade a review report against the review-output eval cases
  history <sub>        record|list|show <id>|latest|compare <a> <b>|clean — review history in .akos/reviews/

AKOS_HOME: $AKOS_HOME
EOF
}

cmd_doctor() {
  bash "$AKOS_HOME/doctor.sh"
}

cmd_list_packs() {
  info "${c_bold}Knowledge packs${c_reset} (in $AKOS_HOME/packs):"
  local domain
  for domain in "$AKOS_HOME"/packs/*/; do
    [ -d "$domain" ] || continue
    local dname; dname="$(basename "$domain")"
    printf '  %s%s%s\n' "$c_bold" "$dname" "$c_reset"
    local pack
    for pack in "$domain"*/; do
      [ -d "$pack" ] || continue
      printf '    - %s\n' "$(basename "$pack")"
    done
  done
}

cmd_list_agents() {
  info "${c_bold}Review agents${c_reset} (in $AKOS_HOME/agents):"
  local a
  for a in "$AKOS_HOME"/agents/*.md; do
    [ -f "$a" ] || continue
    printf '  - %s\n' "$(basename "$a" .md)"
  done
}

cmd_list_skills() {
  info "${c_bold}Agent skills${c_reset} (in $AKOS_HOME/skills):"
  local s name desc
  for s in "$AKOS_HOME"/skills/*/SKILL.md; do
    [ -f "$s" ] || continue
    name="$(basename "$(dirname "$s")")"
    desc="$(sed -n 's/^description:[[:space:]]*//p' "$s" | head -n 1 | cut -c1-72)"
    printf '  - %s%s%s — %s…\n' "$c_bold" "$name" "$c_reset" "$desc"
  done
  info ""
  info "Linked into: ~/.claude/skills (Claude Code) · ~/.agents/skills (Codex CLI)"
  info "Not linked? Run ./install.sh"
}

cmd_show_profile() {
  local name="${1:-}"
  local pf="$AKOS_HOME/core/reasoning-profiles.md"
  if [ -z "$name" ]; then
    info "Available profiles (see $pf):"
    info "  Prototype · Startup MVP · Production · Enterprise · Game Dev · Internal Tool"
    info "Run: akos show-profile \"Production\""
    return
  fi
  info "Profile '$name' — full definition in:"
  info "  $pf"
  # Print the matching section heading region if present.
  awk -v want="### $name" '
    $0 ~ "^### " {show = ($0 == want)}
    show {print}
  ' "$pf" 2>/dev/null || true
}

cmd_review() {
  local domain="${1:-}"
  case "$domain" in
    ux)           cat "$AKOS_HOME/prompts/run-ux-review.md" ;;
    security)     cat "$AKOS_HOME/prompts/run-security-review.md" ;;
    architecture) cat "$AKOS_HOME/prompts/run-architecture-review.md" ;;
    full)         cat "$AKOS_HOME/prompts/run-full-review.md" ;;
    *)
      err "Unknown review domain: '${domain:-}'. Use: ux | security | architecture | full"
      return 1 ;;
  esac
}

cmd_validate() {
  # Tail-call, deliberately the literal last statement: under `set -e` this
  # propagates schemas/validate.py's own exit code (0/1/2) with nothing extra
  # needed. Do not add post-processing here without `|| rc=$?` guarding.
  python3 "$AKOS_HOME/schemas/validate.py" "$@"
}

cmd_eval() {
  # Tail-call: literal last statement so 0/1/2 propagates untouched.
  python3 "$AKOS_HOME/evals/runners/grade.py" "$@"
}

cmd_check_config() {
  # Same tail-call rule as cmd_validate: literal last statement, so the
  # 0/1/2 exit code propagates untouched.
  python3 "$AKOS_HOME/schemas/config_check.py" "$@"
}

cmd_install_project() {
  local dir="${1:-$PWD}"
  info "Installing AKOS integration into: $dir"

  local claude_body agents_body cursor_body config_body
  # Short block: the `akos` skill carries the bootstrap in Claude Code and
  # Codex CLI, so this only needs to signal that AKOS applies here.
  claude_body=$(cat <<'BODY'
## AKOS
This project uses AKOS. Invoke the `akos` skill before non-trivial work on
user-facing features, architecture, security, or data; `akos-review` to review.
Active profile and overrides: `.akos/config.md`
BODY
)
  agents_body="$claude_body"
  cursor_body=$(cat <<'BODY'
---
description: AKOS knowledge system integration
alwaysApply: true
---

# AKOS

This project uses AKOS (global knowledge system at ~/DEV/AKOS). For user-facing features, architecture, security, or data work, load the relevant AKOS knowledge first.

Bootstrap: ~/DEV/AKOS/core/{constitution,authority-model,reasoning-profiles,review-pipeline}.md, then the personal layer named in .akos/config.md (personal_profile field, default pau-avila) at ~/DEV/AKOS/packs/personal/<profile>/. Load the 2-5 relevant packs from ~/DEV/AKOS/packs/. For reviews use ~/DEV/AKOS/agents/ and the unified Review Summary format.

Safety floor (never waived): security, accessibility basics, data integrity.
Defaults: four async states; mobile-responsive by default; Supabase RLS at table creation (deployed); challenge complexity; anti-template UI; direct actionable output.
BODY
)
  config_body=$(cat <<'BODY'
# AKOS Project Config

## Reasoning profile
profile: Startup MVP

## Personal profile
personal_profile: pau-avila

## Project context
- Stack:
- Deployed: no
- Primary surface:

## Profile overrides

## Packs to always load

## Style direction

## Notes
BODY
)

  write_marked_section "$dir/CLAUDE.md" "$claude_body"
  write_marked_section "$dir/AGENTS.md" "$agents_body"
  write_marked_section "$dir/.cursor/rules/akos.mdc" "$cursor_body"
  write_marked_section "$dir/.akos/config.md" "$config_body"

  # Review reports quote the defects they find — including, on a security
  # lens, the credential itself. `akos history record` redacts known secret
  # shapes at write time, but redaction is pattern-based and will miss
  # things, so the stored reports should not be pushed by default. Append
  # only if absent, and never rewrite an existing .gitignore.
  local gitignore="$dir/.gitignore"
  if [ ! -f "$gitignore" ] || ! grep -qxF ".akos/reviews/" "$gitignore"; then
    {
      [ -f "$gitignore" ] && [ -s "$gitignore" ] && printf '\n'
      printf '# AKOS review reports — may quote secrets found during a review\n'
      printf '.akos/reviews/\n'
    } >> "$gitignore"
    ok "Added .akos/reviews/ to .gitignore (review reports can quote what they find)."
  fi

  ok "AKOS integration installed. Edit .akos/config.md to set the profile and style direction."
}

cmd_create_pack() {
  local path="${1:-}"
  if [ -z "$path" ]; then err "Usage: akos create-pack <domain>/<name>"; return 1; fi
  local name; name="$(basename "$path")"
  local domain; domain="$(dirname "$path")"
  if [ "$path" != "$domain/$name" ] || ! valid_segment "$domain" || ! valid_segment "$name"; then
    err "Invalid pack path: '$path'. Expected <domain>/<name>, each lowercase [a-z0-9-]."
    return 1
  fi
  local dest="$AKOS_HOME/packs/$path"
  if [ -d "$dest" ]; then err "Pack already exists: $dest"; return 1; fi
  mkdir -p "$dest"

  local files=(README.md philosophy.md mental-models.md principles.md heuristics.md \
    engineering-rules.md decision-framework.md anti-patterns.md review-checklist.md \
    examples.md prompt-fragments.md scoring-rubric.md glossary.md references.md)
  local f
  for f in "${files[@]}"; do
    printf '# %s — %s\n\n<!-- Fill per core/knowledge-schema.md. Distill, never copy (core/source-policy.md). -->\n' \
      "${f%.md}" "$name" > "$dest/$f"
  done
  printf '1.0.0\n' > "$dest/VERSION"
  local today; today="$(date +%Y-%m-%d)"
  # Cadence matches bin/migrate-pack-metadata.py's CADENCE_DAYS for
  # authority-level 3 (books/methodologies, the default for a new pack).
  # Date math shells to python3 rather than bash `date` arithmetic — BSD and
  # GNU `date` diverge on epoch<->calendar conversion, python3's stdlib
  # doesn't, and it's already the repo's one accepted dependency.
  local review_after
  review_after="$(python3 -c "from datetime import date, timedelta; print((date.today()+timedelta(days=270)).isoformat())" 2>/dev/null || echo "$today")"
  printf '# Changelog — %s\n\n## [1.0.0] — %s\n\n### Added\n\n- Scaffolded.\n' "$name" "$today" > "$dest/CHANGELOG.md"
  cat > "$dest/metadata.yaml" <<EOF
name: $name
domain: $domain
authority-level: 3
version: 1.0.0
tags: []
sources: []
related: []
id: $domain/$name
status: draft
last_reviewed: $today
review_after: $review_after
maintainer: core
license: MIT
deprecated: false
EOF
  ok "Scaffolded pack at $dest (17 files). Fill principles.md first."
  warn "Add '$name' to the routing table in skills/akos/SKILL.md, then run ./doctor.sh"
}

cmd_profile() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    list)   cmd_profile_list ;;
    show)   cmd_profile_show "$@" ;;
    create) cmd_profile_create "$@" ;;
    use)    cmd_profile_use "$@" ;;
    *)      err "Usage: akos profile <list|show|create|use> [name]"; return 1 ;;
  esac
}

cmd_profile_list() {
  info "${c_bold}Personal profiles${c_reset} (in $AKOS_HOME/packs/personal):"
  local p name
  for p in "$AKOS_HOME"/packs/personal/*/; do
    [ -d "$p" ] || continue
    name="$(basename "$p")"
    [ "$name" = "_template" ] && continue
    printf '  - %s\n' "$name"
  done
}

cmd_profile_show() {
  local name="${1:-}"
  if [ -z "$name" ]; then err "Usage: akos profile show <name>"; return 1; fi
  local dir="$AKOS_HOME/packs/personal/$name"
  if [ ! -d "$dir" ]; then err "No such profile: $name (run 'akos profile list')"; return 1; fi
  cat "$dir/README.md"
  echo
  cat "$dir/principles.md"
}

cmd_profile_create() {
  local name="${1:-}"
  if [ -z "$name" ]; then err "Usage: akos profile create <name>"; return 1; fi
  if ! valid_segment "$name"; then
    err "Invalid profile name: '$name'. Lowercase [a-z0-9-] only."
    return 1
  fi
  local dir="$AKOS_HOME/packs/personal/$name"
  if [ -d "$dir" ]; then err "Profile already exists: $dir"; return 1; fi
  cp -R "$AKOS_HOME/packs/personal/_template" "$dir"
  # Fill in the placeholder name across the copied files. Shells to python3
  # rather than `sed -i` — BSD and GNU sed diverge on the in-place suffix
  # argument; python3 is already the repo's one accepted dependency.
  # Values travel as argv, never interpolated into the script text: an
  # interpolated name containing a quote was an arbitrary-code injection.
  python3 - "$dir" "$name" <<'PY'
import pathlib, sys
d, name = pathlib.Path(sys.argv[1]), sys.argv[2]
for f in d.glob('*.md'):
    text = f.read_text()
    f.write_text(text.replace('<your name>', name))
PY
  ok "Scaffolded personal profile at $dir (10 files). Fill principles.md first."
  warn "Run 'akos profile use $name' in a project to activate it there."
}

cmd_profile_use() {
  local name="${1:-}"
  local dir="${2:-$PWD}"
  if [ -z "$name" ]; then err "Usage: akos profile use <name> [project-dir]"; return 1; fi
  if [ ! -d "$AKOS_HOME/packs/personal/$name" ]; then
    err "No such profile: $name (run 'akos profile list')"; return 1
  fi
  local config="$dir/.akos/config.md"
  if [ ! -f "$config" ]; then
    err "$config not found — run 'akos install-project' in $dir first"; return 1
  fi
  local body
  body="$(awk -v start="$MARK_START" -v end="$MARK_END" '
    $0 ~ start {f=1; next} $0 ~ end {f=0} f {print}
  ' "$config")"
  if [ -z "$body" ]; then
    err "$config has no AKOS-managed section — run 'akos install-project' first"; return 1
  fi
  if printf '%s\n' "$body" | grep -q '^personal_profile:'; then
    body="$(printf '%s\n' "$body" | sed "s/^personal_profile:.*/personal_profile: $name/")"
  else
    body="$(printf '%s\n\n## Personal profile\npersonal_profile: %s\n' "$body" "$name")"
  fi
  write_marked_section "$config" "$body"
  ok "personal_profile set to '$name' in $config"
}

cmd_freshness() {
  python3 "$AKOS_HOME/schemas/freshness.py" "$@"
}

cmd_history() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    record)
      # Timestamp computed here, not in schemas/history.py, so the LLM
      # caller (akos-review's skill instructions) never needs to supply
      # one — "run akos history record --type ... --report ..." is the
      # whole ask.
      local ts; ts="$(date -u +%Y%m%dT%H%M%SZ)"
      python3 "$AKOS_HOME/schemas/history.py" record --timestamp "$ts" "$@"
      ;;
    list|show|latest|compare|clean)
      python3 "$AKOS_HOME/schemas/history.py" "$sub" "$@"
      ;;
    *) err "Usage: akos history <record|list|show <id>|latest|compare <a> <b>|clean>"; return 1 ;;
  esac
}

cmd_benchmark() {
  python3 "$AKOS_HOME/benchmarks/runners/run.py" "$@"
}

cmd_rules() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    list)    cmd_rules_list ;;
    run)     python3 "$AKOS_HOME/rules/runner.py" "$@" ;;
    explain) cmd_rules_explain "$@" ;;
    *)       err "Usage: akos rules <list|run <dir>|explain <ID>>"; return 1 ;;
  esac
}

cmd_rules_list() {
  info "${c_bold}Rules${c_reset} (in $AKOS_HOME/rules):"
  local y id title level domain
  for y in "$AKOS_HOME"/rules/*/*.yaml; do
    [ -f "$y" ] || continue
    id="$(sed -n 's/^id:[[:space:]]*//p' "$y" | head -n1)"
    title="$(sed -n 's/^title:[[:space:]]*//p' "$y" | head -n1)"
    level="$(sed -n 's/^level:[[:space:]]*//p' "$y" | head -n1)"
    domain="$(sed -n 's/^domain:[[:space:]]*//p' "$y" | head -n1)"
    printf '  %-32s [%s/%s] %s\n' "$id" "$domain" "$level" "$title"
  done
}

cmd_rules_explain() {
  local id="${1:-}"
  if [ -z "$id" ]; then err "Usage: akos rules explain <RULE_ID>"; return 1; fi
  local y
  for y in "$AKOS_HOME"/rules/*/*.yaml; do
    [ -f "$y" ] || continue
    if grep -qF "id: $id" "$y"; then
      cat "$y"
      return
    fi
  done
  err "No such rule: $id (run 'akos rules list')"; return 1
}

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    help|-h|--help)     cmd_help ;;
    doctor)             cmd_doctor ;;
    install-project)    cmd_install_project "$@" ;;
    link-project)       cmd_install_project "$@" ;;
    list-packs)         cmd_list_packs ;;
    list-agents)        cmd_list_agents ;;
    list-skills)        cmd_list_skills ;;
    show-profile)       cmd_show_profile "$@" ;;
    validate)           cmd_validate "$@" ;;
    check-config)       cmd_check_config "$@" ;;
    eval)               cmd_eval "$@" ;;
    review)             cmd_review "$@" ;;
    create-pack)        cmd_create_pack "$@" ;;
    profile)            cmd_profile "$@" ;;
    rules)              cmd_rules "$@" ;;
    freshness)          cmd_freshness "$@" ;;
    benchmark)          cmd_benchmark "$@" ;;
    history)            cmd_history "$@" ;;
    *)                  err "Unknown command: $cmd"; echo; cmd_help; exit 1 ;;
  esac
}
main "$@"
