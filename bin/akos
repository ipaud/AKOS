#!/usr/bin/env bash
#
# akos — AI Knowledge Operating System CLI
# Tool-agnostic. Generates project integration files; does not call an LLM.
#
set -euo pipefail

# --- Resolve AKOS_HOME (the repo root), following symlinks ---
resolve_akos_home() {
  local src="${BASH_SOURCE[0]}"
  while [ -h "$src" ]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  # bin/akos → repo root is one level up
  cd -P "$(dirname "$src")/.." >/dev/null 2>&1 && pwd
}
AKOS_HOME="${AKOS_HOME:-$(resolve_akos_home)}"

# shellcheck source=bin/akos-common.sh
source "$AKOS_HOME/bin/akos-common.sh"

c_bold=$'\033[1m'; c_green=$'\033[32m'; c_yellow=$'\033[33m'; c_red=$'\033[31m'; c_reset=$'\033[0m'
info()  { printf '%s\n' "$*"; }
ok()    { printf '%s✓%s %s\n' "$c_green" "$c_reset" "$*"; }
warn()  { printf '%s!%s %s\n' "$c_yellow" "$c_reset" "$*"; }
err()   { printf '%s✗%s %s\n' "$c_red" "$c_reset" "$*" >&2; }

# --- Name validation for commands that build filesystem paths from user input ---
# Exactly the charset knowledge-pack.schema.json enforces for a pack `name`
# (^[a-z0-9]+(-[a-z0-9]+)*$), so a scaffolded pack always validates. This is
# the CLI-side twin of schemas/config_check.py's packs_root prefix check:
# without it, `akos create-pack "../../evil"` scaffolded outside packs/
# (verified), and a quote in a profile name broke out of an inline
# python3 -c script. Reserved `_`-prefixed dirs (e.g. _template) are fixtures,
# not user-creatable — the schema rejects that name too.
valid_segment() { [[ "$1" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]]; }

# --- Marker-safe file section writer ---
# Thin wrapper around bin/marked_sections.py, the single shared parser for
# AKOS:START/END sections. Creates the file if absent, appends the section
# if markers are absent, replaces between markers if present exactly once —
# and REFUSES (rather than guessing) if the marker structure is ambiguous
# (multiple starts/ends, one-sided, out of order). The bash predecessor
# (`grep -nF ... | head -n1`) silently picked the first pair even when
# duplicates existed; this fails loudly instead, leaving the file untouched.
write_marked_section() {
  local file="$1"; local body="$2"
  printf '%s' "$body" | "$AKOS_PYTHON" "$AKOS_HOME/bin/marked_sections.py" write "$file" --body -
}

cmd_help() {
  cat <<EOF
${c_bold}akos${c_reset} — AI Knowledge Operating System CLI

Usage: akos <command> [args]

Commands:
  help                 Show this help
  doctor               Run the AKOS health check
  install-project [dir] Add AKOS integration files to an existing project
  link-project         Alias for install-project (current directory)
  list-packs [opts]    List stable knowledge packs (--all for every status, --status draft|deprecated|stable)
  list-agents          List all review agents
  list-skills          List the agent skills (Claude Code + Codex CLI)
  show-profile [name]  Show a reasoning profile (or list them)
  review <domain>      Print the prompt to run a review (ux|security|architecture|full)
  create-pack <path>   Scaffold a new pack (e.g. ux/my-source) with the required file set
  validate [target]    Validate packs/agents/workflows against their schemas (--format json)
  check-config [dir]   Check a project's .akos/config.md against the allowed value set
  routing-check        Verify stable/draft pack routing isolation in skills/akos/SKILL.md
  profile <sub>        list|show <name>|create <name>|use <name> [dir] — personal profiles
  rules <sub>          list|run <dir> [--rule ID] [--domain D] [--profile P]|explain <ID>
  freshness [opts]     Pack review-freshness report (--expired|--due-soon|--pack ID|--fail-on BAND)
  benchmark [run|list] Run the rule-detection benchmark suite (--case ID|--domain D|--format json)
  eval --report PATH   Grade a review report against the review-output eval cases
  history <sub>        record|list|show <id>|latest|compare <a> <b>|clean — review history in .akos/reviews/

AKOS_HOME: $AKOS_HOME
EOF
}

cmd_doctor() {
  bash "$AKOS_HOME/doctor.sh"
}

cmd_list_packs() {
  local status_filter="stable"
  while [ $# -gt 0 ]; do
    case "$1" in
      --all) status_filter=""; shift ;;
      --status) status_filter="${2:-}"; shift 2 ;;
      --status=*) status_filter="${1#--status=}"; shift ;;
      *) err "Unknown list-packs option: $1 (usage: list-packs [--all | --status stable|draft|deprecated])"; return 1 ;;
    esac
  done
  if [ -n "$status_filter" ]; then
    case "$status_filter" in
      stable|draft|deprecated) ;;
      *) err "Unknown status: '$status_filter' (must be stable, draft, or deprecated)"; return 1 ;;
    esac
  fi

  # Status-aware listing shells to Python (yaml_subset) rather than a fragile
  # grep over metadata.yaml — draft/stable/deprecated is a real parsed field,
  # not a text pattern. packs/personal/* is excluded: it has no status field
  # and is never a routing choice (see skills/akos/SKILL.md) — use
  # 'akos profile list' for that layer instead.
  "$AKOS_PYTHON" - "$AKOS_HOME" "$status_filter" <<'PY'
import sys
from pathlib import Path

akos_home = Path(sys.argv[1])
status_filter = sys.argv[2] or None
sys.path.insert(0, str(akos_home / "schemas"))
import yaml_subset

c_bold, c_yellow, c_reset = "\033[1m", "\033[33m", "\033[0m"

entries = []
for meta_path in sorted(akos_home.glob("packs/*/*/metadata.yaml")):
    if "personal" in meta_path.parts:
        continue
    domain, name = meta_path.parent.parent.name, meta_path.parent.name
    try:
        data = yaml_subset.load(meta_path)
    except yaml_subset.YamlSubsetError:
        data = {}
    status = data.get("status", "stable") if isinstance(data, dict) else "stable"
    entries.append((domain, name, status))

if status_filter:
    entries = [e for e in entries if e[2] == status_filter]

label = f"status: {status_filter}" if status_filter else "all"
print(f"{c_bold}Knowledge packs{c_reset} ({label}) — {len(entries)} pack(s):")
for domain, name, status in entries:
    tag = f" {c_yellow}({status}){c_reset}" if status != "stable" else ""
    print(f"  {domain}/{name}{tag}")
if not entries:
    print("  (none)")
PY
}

cmd_list_agents() {
  info "${c_bold}Review agents${c_reset} (in $AKOS_HOME/agents):"
  local a
  for a in "$AKOS_HOME"/agents/*.md; do
    [ -f "$a" ] || continue
    printf '  - %s\n' "$(basename "$a" .md)"
  done
}

cmd_list_skills() {
  info "${c_bold}Agent skills${c_reset} (in $AKOS_HOME/skills):"
  local s name desc
  for s in "$AKOS_HOME"/skills/*/SKILL.md; do
    [ -f "$s" ] || continue
    name="$(basename "$(dirname "$s")")"
    desc="$(sed -n 's/^description:[[:space:]]*//p' "$s" | head -n 1 | cut -c1-72)"
    printf '  - %s%s%s — %s…\n' "$c_bold" "$name" "$c_reset" "$desc"
  done
  info ""
  info "Linked into: ~/.claude/skills (Claude Code) · ~/.agents/skills (Codex CLI)"
  info "Not linked? Run ./install.sh"
}

cmd_show_profile() {
  local name="${1:-}"
  local pf="$AKOS_HOME/core/reasoning-profiles.md"
  if [ -z "$name" ]; then
    info "Available profiles (see $pf):"
    info "  Prototype · Startup MVP · Production · Enterprise · Game Dev · Internal Tool"
    info "Run: akos show-profile \"Production\""
    return
  fi
  info "Profile '$name' — full definition in:"
  info "  $pf"
  # Print the matching section heading region if present.
  awk -v want="### $name" '
    $0 ~ "^### " {show = ($0 == want)}
    show {print}
  ' "$pf" 2>/dev/null || true
}

cmd_review() {
  local domain="${1:-}"
  case "$domain" in
    ux)           cat "$AKOS_HOME/prompts/run-ux-review.md" ;;
    security)     cat "$AKOS_HOME/prompts/run-security-review.md" ;;
    architecture) cat "$AKOS_HOME/prompts/run-architecture-review.md" ;;
    full)         cat "$AKOS_HOME/prompts/run-full-review.md" ;;
    *)
      err "Unknown review domain: '${domain:-}'. Use: ux | security | architecture | full"
      return 1 ;;
  esac
}

cmd_validate() {
  # Tail-call, deliberately the literal last statement: under `set -e` this
  # propagates schemas/validate.py's own exit code (0/1/2) with nothing extra
  # needed. Do not add post-processing here without `|| rc=$?` guarding.
  "$AKOS_PYTHON" "$AKOS_HOME/schemas/validate.py" "$@"
}

cmd_eval() {
  # Tail-call: literal last statement so 0/1/2 propagates untouched.
  "$AKOS_PYTHON" "$AKOS_HOME/evals/runners/grade.py" "$@"
}

cmd_check_config() {
  # Same tail-call rule as cmd_validate: literal last statement, so the
  # 0/1/2 exit code propagates untouched.
  "$AKOS_PYTHON" "$AKOS_HOME/schemas/config_check.py" "$@"
}

cmd_routing_check() {
  # Same tail-call rule: literal last statement, 0/1/2 propagates untouched.
  "$AKOS_PYTHON" "$AKOS_HOME/schemas/routing_check.py" "$@"
}

cmd_install_project() {
  local invoked_as="$1"
  shift
  local command_usage="Usage: akos $invoked_as"
  if [ "$invoked_as" = "install-project" ]; then
    command_usage="$command_usage [project-dir]"
  fi

  if [ "$#" -eq 1 ] && { [ "$1" = "-h" ] || [ "$1" = "--help" ]; }; then
    info "$command_usage"
    return 0
  fi
  if { [ "$invoked_as" = "install-project" ] && [ "$#" -gt 1 ]; } \
      || { [ "$invoked_as" = "link-project" ] && [ "$#" -gt 0 ]; }; then
    err "$command_usage"
    return 1
  fi
  if [ "$#" -eq 1 ] && [[ "$1" == -* ]]; then
    err "Unknown $invoked_as option: $1"
    err "$command_usage"
    return 1
  fi

  local requested_dir="${1:-$PWD}"
  local dir
  if ! dir="$(cd -P -- "$requested_dir" 2>/dev/null && pwd)" || [ ! -d "$dir" ]; then
    err "Expected an existing project directory: $requested_dir"
    err "$command_usage"
    return 1
  fi
  info "Installing AKOS integration into: $dir"

  local claude_body agents_body cursor_body config_body
  # Short block: the `akos` skill carries the bootstrap in Claude Code and
  # Codex CLI, so this only needs to signal that AKOS applies here.
  claude_body=$(cat <<'BODY'
## AKOS
This project uses AKOS. Invoke the `akos` skill before non-trivial work on
user-facing features, architecture, security, or data; `akos-review` to review.
Active profile and overrides: `.akos/config.md`
BODY
)
  agents_body="$claude_body"
  cursor_body=$(cat <<'BODY'
---
description: AKOS knowledge system integration
alwaysApply: true
---

# AKOS

This project uses AKOS (global knowledge system at ~/DEV/AKOS). For user-facing features, architecture, security, or data work, load the relevant AKOS knowledge first.

Bootstrap: ~/DEV/AKOS/core/{constitution,authority-model,reasoning-profiles,review-pipeline}.md, then the personal layer named in .akos/config.md (personal_profile field, default pau-avila) at ~/DEV/AKOS/packs/personal/<profile>/. Load the 2-5 relevant packs from ~/DEV/AKOS/packs/. For reviews use ~/DEV/AKOS/agents/ and the unified Review Summary format.

Safety floor (never waived): security, accessibility basics, data integrity.
Defaults: four async states; mobile-responsive by default; Supabase RLS at table creation (deployed); challenge complexity; anti-template UI; direct actionable output.
BODY
)
  config_body=$(cat <<'BODY'
# AKOS Project Config

## Reasoning profile
profile: Startup MVP

## Personal profile
personal_profile: pau-avila

## Project context
- Stack:
- Deployed: no
- Primary surface:

## Profile overrides

## Packs to always load

## Style direction

## Notes
BODY
)

  # The Python writer resolves the explicit root once, rejects every symlink
  # below it (including .gitignore and parent directories), renders all four
  # managed sections before mutation, and rolls back completed writes if a
  # later atomic replace fails.
  if ! "$AKOS_PYTHON" "$AKOS_HOME/bin/marked_sections.py" install-project "$dir" \
      --claude-body "$claude_body" \
      --agents-body "$agents_body" \
      --cursor-body "$cursor_body" \
      --config-body "$config_body"; then
    err "AKOS integration was not installed; no partial managed-file update was kept."
    return 1
  fi

  ok "AKOS integration installed. Edit .akos/config.md to set the profile and style direction."
}

cmd_create_pack() {
  local path="${1:-}"
  if [ -z "$path" ]; then err "Usage: akos create-pack <domain>/<name>"; return 1; fi
  local name; name="$(basename "$path")"
  local domain; domain="$(dirname "$path")"
  if [ "$path" != "$domain/$name" ] || ! valid_segment "$domain" || ! valid_segment "$name"; then
    err "Invalid pack path: '$path'. Expected <domain>/<name>, each lowercase [a-z0-9-]."
    return 1
  fi
  local dest="$AKOS_HOME/packs/$path"
  if [ -d "$dest" ]; then err "Pack already exists: $dest"; return 1; fi
  mkdir -p "$dest"

  # Scaffold the REQUIRED files only. The five optional file-types
  # (philosophy, mental-models, examples, prompt-fragments, glossary) are added
  # by hand when the source has something distinct to say — scaffolding them as
  # empty stubs was ceremony that made "the template ran" look like content.
  local files=(README.md principles.md heuristics.md \
    engineering-rules.md decision-framework.md anti-patterns.md \
    review-checklist.md scoring-rubric.md references.md)
  local f
  for f in "${files[@]}"; do
    printf '# %s — %s\n\n<!-- Fill per core/knowledge-schema.md. Distill, never copy (core/source-policy.md). -->\n' \
      "${f%.md}" "$name" > "$dest/$f"
  done
  printf '1.0.0\n' > "$dest/VERSION"
  local today; today="$(date +%Y-%m-%d)"
  # Cadence matches bin/migrate-pack-metadata.py's CADENCE_DAYS for
  # authority-level 3 (books/methodologies, the default for a new pack).
  # Date math shells to $AKOS_PYTHON rather than bash `date` arithmetic — BSD
  # and GNU `date` diverge on epoch<->calendar conversion, Python's stdlib
  # doesn't. require_python has already verified 3.10+ is present by this
  # point (main() gates every operational command on it), so a failure HERE
  # is a genuine unexpected error, not "python3 is missing" — it must fail
  # loudly, not silently substitute a wrong-but-plausible date. No partial
  # pack is left behind on that failure, matching the "no half-finished
  # artifact" discipline schemas/history.py's own publish path already has.
  local review_after
  if ! review_after="$("$AKOS_PYTHON" -c "from datetime import date, timedelta; print((date.today()+timedelta(days=270)).isoformat())")"; then
    rm -rf "$dest"
    err "review_after date computation failed — no partial pack was left behind at $dest"
    return 1
  fi
  printf '# Changelog — %s\n\n## [1.0.0] — %s\n\n### Added\n\n- Scaffolded.\n' "$name" "$today" > "$dest/CHANGELOG.md"
  cat > "$dest/metadata.yaml" <<EOF
schema_version: 1
name: $name
domain: $domain
authority-level: 3
version: 1.0.0
tags: []
sources: []
related: []
id: $domain/$name
status: draft
last_reviewed: $today
review_after: $review_after
maintainer: core
license: MIT
deprecated: false
EOF
  ok "Scaffolded pack at $dest (12 required files). Fill principles.md first."
  warn "status: draft — this pack will NOT be auto-routed until promoted to stable."
  warn "Add '$name' to the Experimental section in skills/akos/SKILL.md, then run ./doctor.sh"
}

cmd_profile() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    list)   cmd_profile_list ;;
    show)   cmd_profile_show "$@" ;;
    create) cmd_profile_create "$@" ;;
    use)    cmd_profile_use "$@" ;;
    *)      err "Usage: akos profile <list|show|create|use> [name]"; return 1 ;;
  esac
}

cmd_profile_list() {
  info "${c_bold}Personal profiles${c_reset} (in $AKOS_HOME/packs/personal):"
  local p name
  for p in "$AKOS_HOME"/packs/personal/*/; do
    [ -d "$p" ] || continue
    name="$(basename "$p")"
    [ "$name" = "_template" ] && continue
    printf '  - %s\n' "$name"
  done
}

cmd_profile_show() {
  local name="${1:-}"
  if [ -z "$name" ]; then err "Usage: akos profile show <name>"; return 1; fi
  local dir="$AKOS_HOME/packs/personal/$name"
  if [ ! -d "$dir" ]; then err "No such profile: $name (run 'akos profile list')"; return 1; fi
  cat "$dir/README.md"
  echo
  cat "$dir/principles.md"
}

cmd_profile_create() {
  local name="${1:-}"
  if [ -z "$name" ]; then err "Usage: akos profile create <name>"; return 1; fi
  if ! valid_segment "$name"; then
    err "Invalid profile name: '$name'. Lowercase [a-z0-9-] only."
    return 1
  fi
  local dir="$AKOS_HOME/packs/personal/$name"
  if [ -d "$dir" ]; then err "Profile already exists: $dir"; return 1; fi
  cp -R "$AKOS_HOME/packs/personal/_template" "$dir"
  # Fill in the placeholder name across the copied files. Shells to python3
  # rather than `sed -i` — BSD and GNU sed diverge on the in-place suffix
  # argument; python3 is already the repo's one accepted dependency.
  # Values travel as argv, never interpolated into the script text: an
  # interpolated name containing a quote was an arbitrary-code injection.
  # Wrapped in `if ! ... ; then` (rather than a bare tail statement) so a
  # failure here is caught instead of letting `set -e` abort mid-scaffold —
  # the copy at line 384 already exists on disk by this point, and a raw
  # abort here used to leave a half-filled profile dir with literal
  # '<your name>' placeholders and no indication anything went wrong.
  if ! "$AKOS_PYTHON" - "$dir" "$name" <<'PY'
import pathlib, sys
d, name = pathlib.Path(sys.argv[1]), sys.argv[2]
for f in d.glob('*.md'):
    text = f.read_text()
    f.write_text(text.replace('<your name>', name))
PY
  then
    rm -rf "$dir"
    err "Failed to scaffold profile '$name' — no partial profile was left behind."
    return 1
  fi
  ok "Scaffolded personal profile at $dir (10 files). Fill principles.md first."
  warn "Run 'akos profile use $name' in a project to activate it there."
}

cmd_profile_use() {
  local name="${1:-}"
  local dir="${2:-$PWD}"
  if [ -z "$name" ]; then err "Usage: akos profile use <name> [project-dir]"; return 1; fi
  if [ ! -d "$AKOS_HOME/packs/personal/$name" ]; then
    err "No such profile: $name (run 'akos profile list')"; return 1
  fi
  local config="$dir/.akos/config.md"
  if [ ! -f "$config" ]; then
    err "$config not found — run 'akos install-project' in $dir first"; return 1
  fi
  # Read, transform, and replace through the same root-anchored transaction as
  # install-project. The Python side rejects `.akos`, config.md, or any future
  # child parent that is a symlink, and keeps the marker validation and atomic
  # rollback in one operation rather than a path-based extract/write pair.
  if ! "$AKOS_PYTHON" "$AKOS_HOME/bin/marked_sections.py" \
      set-personal-profile "$dir" "$name"; then
    err "$config has no usable AKOS-managed section — run 'akos install-project' first, or fix the marker structure named above."
    return 1
  fi
  ok "personal_profile set to '$name' in $config"
}

cmd_freshness() {
  "$AKOS_PYTHON" "$AKOS_HOME/schemas/freshness.py" "$@"
}

cmd_history() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    record)
      # Timestamp computed here, not in schemas/history.py, so the LLM
      # caller (akos-review's skill instructions) never needs to supply
      # one — "run akos history record --type ... --report ..." is the
      # whole ask. This is only the sortable, human-readable PREFIX of the
      # review id, not the unique identifier: history.py appends random
      # entropy so two records in the same second do not collide.
      local ts; ts="$(date -u +%Y%m%dT%H%M%SZ)"
      "$AKOS_PYTHON" "$AKOS_HOME/schemas/history.py" record --timestamp "$ts" "$@"
      ;;
    list|show|latest|compare|clean)
      "$AKOS_PYTHON" "$AKOS_HOME/schemas/history.py" "$sub" "$@"
      ;;
    *) err "Usage: akos history <record|list|show <id>|latest|compare <a> <b>|clean>"; return 1 ;;
  esac
}

cmd_benchmark() {
  "$AKOS_PYTHON" "$AKOS_HOME/benchmarks/runners/run.py" "$@"
}

cmd_rules() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    list)    cmd_rules_list ;;
    run)     "$AKOS_PYTHON" "$AKOS_HOME/rules/runner.py" "$@" ;;
    explain) cmd_rules_explain "$@" ;;
    *)       err "Usage: akos rules <list|run <dir>|explain <ID>>"; return 1 ;;
  esac
}

cmd_rules_list() {
  info "${c_bold}Rules${c_reset} (in $AKOS_HOME/rules):"
  local y id title level domain
  for y in "$AKOS_HOME"/rules/*/*.yaml; do
    [ -f "$y" ] || continue
    id="$(sed -n 's/^id:[[:space:]]*//p' "$y" | head -n1)"
    title="$(sed -n 's/^title:[[:space:]]*//p' "$y" | head -n1)"
    level="$(sed -n 's/^level:[[:space:]]*//p' "$y" | head -n1)"
    domain="$(sed -n 's/^domain:[[:space:]]*//p' "$y" | head -n1)"
    printf '  %-32s [%s/%s] %s\n' "$id" "$domain" "$level" "$title"
  done
}

cmd_rules_explain() {
  local id="${1:-}"
  if [ -z "$id" ]; then err "Usage: akos rules explain <RULE_ID>"; return 1; fi
  local y
  for y in "$AKOS_HOME"/rules/*/*.yaml; do
    [ -f "$y" ] || continue
    if grep -qF "id: $id" "$y"; then
      cat "$y"
      return
    fi
  done
  err "No such rule: $id (run 'akos rules list')"; return 1
}

main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    help|-h|--help) cmd_help; return ;;
    doctor)
      # Doctor must run without Python — it is the health check that REPORTS
      # Python's absence (or too-old a version) as a finding among others,
      # not a command that can refuse to run because of it.
      cmd_doctor; return ;;
  esac
  require_python || exit 1
  case "$cmd" in
    install-project)    cmd_install_project install-project "$@" ;;
    link-project)       cmd_install_project link-project "$@" ;;
    list-packs)         cmd_list_packs "$@" ;;
    list-agents)        cmd_list_agents ;;
    list-skills)        cmd_list_skills ;;
    show-profile)       cmd_show_profile "$@" ;;
    validate)           cmd_validate "$@" ;;
    check-config)       cmd_check_config "$@" ;;
    routing-check)      cmd_routing_check "$@" ;;
    eval)               cmd_eval "$@" ;;
    review)             cmd_review "$@" ;;
    create-pack)        cmd_create_pack "$@" ;;
    profile)            cmd_profile "$@" ;;
    rules)              cmd_rules "$@" ;;
    freshness)          cmd_freshness "$@" ;;
    benchmark)          cmd_benchmark "$@" ;;
    history)            cmd_history "$@" ;;
    *)                  err "Unknown command: $cmd"; echo; cmd_help; exit 1 ;;
  esac
}
main "$@"
